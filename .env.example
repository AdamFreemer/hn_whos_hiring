# --- Browser (safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Server only (the cron route) — never prefix these with NEXT_PUBLIC ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Shared secret. Set this in Vercel project env; Vercel auto-sends it on cron
# invocations as "Authorization: Bearer <CRON_SECRET>". Used to reject random
# hits to /api/cron/ingest. Generate with: openssl rand -hex 32
CRON_SECRET=YOUR_LONG_RANDOM_STRING
